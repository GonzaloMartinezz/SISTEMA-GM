# ===========================================================================
# SISTEMA GM · Variables de Entorno del Frontend
# Copiar a .env y completar.
# ===========================================================================

VITE_SUPABASE_URL="tu_supabase_url_aqui"
VITE_SUPABASE_PUBLISHABLE_KEY="tu_supabase_publishable_key_aqui"

# Backend Node/Express (Render o local)
VITE_API_URL="http://localhost:5000/api"

# Google Maps (Módulo 7 · Mapa y Logística)
VITE_GOOGLE_MAPS_API_KEY="tu_clave_de_api_de_google_maps_aqui"

# Validación de acceso a los módulos:
#   local    -> usa el padrón de src/config/moduleCredentials.js
#   supabase -> valida server-side con la RPC gm_validar_acceso_modulo
VITE_AUTH_MODE="local"
